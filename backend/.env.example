# Flask Environment
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# Security Keys
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret

# Database Configuration
# PostgreSQL + PostGIS connection string
# Format: postgresql://<username>:<password>@localhost:5432/<database>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/darukaa_earth

# CORS Configuration (comma-separated origins allowed for frontend access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

